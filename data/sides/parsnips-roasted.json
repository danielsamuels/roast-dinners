    },
    {
      "id": "parsnips-roasted-toss",
      "dishId": "parsnips-roasted",
      "summary": "Toss parsnips with oil and seasoning",
      "instruction": "Place the parsnips on a baking tray. Drizzle with olive oil and honey, add the rosemary sprigs, and season with salt and pepper. Toss together until evenly coated. Spread out in a single layer.",
      "durationMinutes": 5,
      "resource": "none",
      "ovenTempCelsius": null,
