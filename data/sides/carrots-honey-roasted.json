    {
      "id": "carrots-honey-roasted-toss",
      "dishId": "carrots-honey-roasted",
      "summary": "Toss carrots with honey glaze",
      "instruction": "Place the carrots on a baking tray. Drizzle with olive oil and honey, and scatter over the thyme sprigs. Season with salt and pepper. Toss everything together with your hands until the carrots are evenly coated. Spread them out in a single layer — don't overcrowd the tray or they will steam rather than roast.",
      "durationMinutes": 5,
      "resource": "none",
