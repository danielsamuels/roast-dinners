    },
    {
      "id": "stuffing-mix",
      "dishId": "stuffing",
      "summary": "Mix the stuffing",
      "instruction": "Place the breadcrumbs in a large mixing bowl. Finely chop the sage and parsley and add to the bowl along with the cooked onion and all the buttery juices. Grate in the zest of half a lemon and squeeze in a little juice. Season with salt and pepper. Beat the egg and stir it in to bind the mixture — it should be moist but hold its shape when pressed together. If it seems dry, add a splash of water.",
      "durationMinutes": 5,
      "resource": "none",
      "ovenTempCelsius": null,
      "requiredEquipment": ["mixing-bowl"],
      "canPrepAhead": true,
      "dependsOn": ["stuffing-cook-onion"],
      "tags": ["prep"]
    },
    {
      "id": "stuffing-bake",
      "dishId": "stuffing",
      "summary": "Bake the stuffing",
      "instruction": "Preheat the oven to 190°C fan (or use the oven that is already on for the roast). Spoon the stuffing mixture into a greased baking dish and press down gently — don't pack it too tightly. Bake for 25 minutes until golden and crispy on top but still soft in the middle.",
