  "steps": [
    {
      "id": "stuffing-cook-onion",
      "dishId": "stuffing",
      "summary": "Cook the onion for the stuffing",
      "instruction": "Finely dice the onion. Melt the butter in a frying pan over a medium heat. Add the onion and cook gently for about 8–10 minutes, stirring occasionally, until soft and translucent but not browned. Remove from the heat and allow to cool slightly.",
