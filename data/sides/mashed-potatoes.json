  "steps": [
    {
      "id": "mashed-potatoes-peel",
      "dishId": "mashed-potatoes",
      "summary": "Peel and cut the potatoes",
      "instruction": "Peel the potatoes and cut them into even-sized chunks — roughly 3–4cm. Keeping them a similar size ensures they cook evenly. Place them in a large saucepan.",
      "durationMinutes": 10,
      "resource": "none",
      "ovenTempCelsius": null,
