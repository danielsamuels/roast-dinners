  "steps": [
    {
      "id": "roast-potatoes-peel",
      "dishId": "roast-potatoes",
      "summary": "Peel and cut the potatoes",
      "instruction": "Peel the potatoes and cut them into large, even-sized chunks — roughly the size of a small egg. Try to keep them a similar size so they cook evenly. If the potatoes are small, just halve them.",
      "durationMinutes": 10,
      "resource": "none",
      "ovenTempCelsius": null,
      "requiredEquipment": ["peeler", "chopping-board", "knife"],
      "canPrepAhead": true,
      "dependsOn": [],
      "tags": ["prep"]
    },
    {
      "id": "roast-potatoes-parboil",
      "dishId": "roast-potatoes",
      "summary": "Parboil the potatoes",
      "instruction": "Place the potatoes in a large saucepan of cold, salted water. Bring to the boil over high heat, then reduce to a simmer and cook for 10 minutes — the edges should be just starting to soften and look a little fluffy. Don't overcook them or they'll fall apart.",
      "durationMinutes": 15,
      "resource": "hob",
      "ovenTempCelsius": null,
      "requiredEquipment": ["large-saucepan"],
      "canPrepAhead": true,
      "dependsOn": ["roast-potatoes-peel"],
      "tags": ["prep"]
    },
    {
      "id": "roast-potatoes-rough-up",
      "dishId": "roast-potatoes",
      "summary": "Drain and rough up the potatoes",
      "instruction": "Drain the potatoes in a colander and let them steam-dry for a couple of minutes. Give the colander a few good shakes to rough up the edges — these fluffy edges are what make the potatoes crispy. Sprinkle over the semolina and toss gently to coat.",
      "durationMinutes": 5,
      "resource": "none",
      "ovenTempCelsius": null,
      "requiredEquipment": ["colander"],
      "canPrepAhead": true,
      "dependsOn": ["roast-potatoes-parboil"],
      "tags": ["prep"]
    },
    {
      "id": "roast-potatoes-roast",
      "dishId": "roast-potatoes",
      "summary": "Roast the potatoes",
      "instruction": "Put the goose fat into a large baking tray and place in the oven at 200°C fan for 5 minutes until the fat is smoking hot. Carefully add the potatoes to the hot fat — they should sizzle. Turn each potato to coat it in the fat. Add the rosemary sprigs and unpeeled garlic cloves. Roast for 45–50 minutes, turning halfway through, until deep golden and crispy all over. Season with salt and pepper.",
      "durationMinutes": 50,
      "resource": "oven",
      "ovenTempCelsius": 200,
      "requiredEquipment": ["baking-tray"],
      "canPrepAhead": false,
      "dependsOn": ["roast-potatoes-rough-up"],
      "tags": ["cook"]
    }
  ],
