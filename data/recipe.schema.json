{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Roast Dinner Planner Recipe Data",
  "description": "Validates meat cuts, sides, ingredient catalogue, and condiments",

  "definitions": {
    "meatType": {
      "type": "string",
      "enum": ["chicken", "beef", "lamb", "pork"]
    },
    "doneness": {
      "type": "string",
      "enum": ["rare", "medium-rare", "medium", "medium-well", "well-done"]
    },
    "resource": {
      "type": "string",
      "enum": ["oven", "hob", "none"]
    },
    "stepTag": {
      "type": "string",
      "enum": ["prep", "cook", "rest", "serve"]
    },
    "shoppingCategory": {
      "type": "string",
      "enum": [
        "meat-and-fish",
        "fresh-vegetables",
        "dairy-and-eggs",
        "storecupboard",
        "frozen",
        "bakery",
        "condiments"
      ]
    },
    "sideCategory": {
      "type": "string",
      "enum": ["staple", "vegetable", "extra"]
    },
    "dietaryFlag": {
      "type": "string",
      "enum": ["gluten-free", "dairy-free", "vegetarian", "vegan", "nut-free"]
    },

    "donenessTime": {
      "type": "object",
      "required": ["minutesPerKg", "baseMinutes"],
      "properties": {
        "minutesPerKg": { "type": "number", "minimum": 0 },
        "baseMinutes": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "cookingTimePerWeight": {
      "type": "object",
      "required": ["type", "doneness", "restingMinutes"],
      "properties": {
        "type": { "type": "string", "const": "per-weight" },
        "doneness": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/definitions/doneness" },
          "additionalProperties": { "$ref": "#/definitions/donenessTime" }
        },
        "restingMinutes": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "cookingTimeFixed": {
      "type": "object",
      "required": ["type", "minutes", "restingMinutes"],
      "properties": {
        "type": { "type": "string", "const": "fixed" },
        "minutes": { "type": "number", "minimum": 0 },
        "restingMinutes": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "cookingTime": {
      "oneOf": [
        { "$ref": "#/definitions/cookingTimePerWeight" },
        { "$ref": "#/definitions/cookingTimeFixed" }
      ]
    },

    "breakpoint": {
      "type": "object",
      "required": ["minServings", "maxServings", "quantity"],
      "properties": {
        "minServings": { "type": "integer", "minimum": 1 },
        "maxServings": { "type": "integer", "minimum": 1 },
        "quantity": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "ingredientRef": {
      "type": "object",
      "required": [
        "ingredientId",
        "baseQuantity",
        "baseServings",
        "scalingGroup",
        "isBreakpointIngredient"
      ],
      "properties": {
        "ingredientId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "baseQuantity": { "type": "number", "minimum": 0 },
        "baseServings": { "type": "integer", "minimum": 1 },
        "scalingGroup": { "type": "string" },
        "isBreakpointIngredient": { "type": "boolean" },
        "breakpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/breakpoint" }
        }
      },
      "additionalProperties": false
    },

    "recipeStep": {
      "type": "object",
      "required": [
        "id",
        "dishId",
        "summary",
        "instruction",
        "durationMinutes",
        "resource",
        "ovenTempCelsius",
        "requiredEquipment",
        "canPrepAhead",
        "dependsOn",
        "tags"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "dishId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "durationMinutes": { "type": "number", "minimum": 0 },
        "resource": { "$ref": "#/definitions/resource" },
        "ovenTempCelsius": {
          "oneOf": [
            { "type": "number", "minimum": 50, "maximum": 300 },
            { "type": "null" }
          ]
        },
        "requiredEquipment": {
          "type": "array",
          "items": { "type": "string" }
        },
        "canPrepAhead": { "type": "boolean" },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/definitions/stepTag" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },

    "sideVariant": {
      "type": "object",
      "required": ["id", "name", "ingredients", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "ingredients": {
          "type": "array",
          "items": { "$ref": "#/definitions/ingredientRef" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/recipeStep" }
        }
      },
      "additionalProperties": false
    },

    "meatCut": {
      "type": "object",
      "required": [
        "id",
        "name",
        "meat",
        "weightPerPersonKg",
        "supportsDonenessSelection",
        "cookingTime",
        "suggestedCondiments",
        "ingredients",
        "steps"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "meat": { "$ref": "#/definitions/meatType" },
        "weightPerPersonKg": { "type": "number", "exclusiveMinimum": 0 },
        "supportsDonenessSelection": { "type": "boolean" },
        "cookingTime": { "$ref": "#/definitions/cookingTime" },
        "suggestedCondiments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ingredients": {
          "type": "array",
          "items": { "$ref": "#/definitions/ingredientRef" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/recipeStep" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },

    "side": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "variants",
        "homemadeAvailable",
        "preMadeOption",
        "ingredients",
        "steps",
        "dietaryFlags"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/definitions/sideCategory" },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/definitions/sideVariant" }
        },
        "homemadeAvailable": { "type": "boolean" },
        "preMadeOption": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "ingredients": {
          "type": "array",
          "items": { "$ref": "#/definitions/ingredientRef" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/recipeStep" }
        },
        "dietaryFlags": {
          "type": "array",
          "items": { "$ref": "#/definitions/dietaryFlag" }
        }
      },
      "additionalProperties": false
    },

    "ingredient": {
      "type": "object",
      "required": ["name", "defaultUnit", "category"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "defaultUnit": {
          "type": "string",
          "enum": ["g", "ml", "whole", "tsp", "tbsp", "kg"]
        },
        "category": { "$ref": "#/definitions/shoppingCategory" }
      },
      "additionalProperties": false
    },

    "condiment": {
      "type": "object",
      "required": [
        "id",
        "name",
        "shoppingCategory",
        "shoppingListName",
        "suggestedForMeats"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "shoppingCategory": { "$ref": "#/definitions/shoppingCategory" },
        "shoppingListName": { "type": "string", "minLength": 1 },
        "suggestedForMeats": {
          "type": "array",
          "items": { "$ref": "#/definitions/meatType" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },

    "ingredientCatalogue": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": { "$ref": "#/definitions/ingredient" }
      },
      "additionalProperties": false
    },

    "condimentsArray": {
      "type": "array",
      "items": { "$ref": "#/definitions/condiment" }
    }
  }
}
